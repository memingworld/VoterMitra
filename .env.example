# ==========================================
# VoterMitra Environment Variables
# Copy this file to .env.local for local development.
# ==========================================

# Database Connection (Supabase PostgreSQL Transaction Pooler, port 6543)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?sslmode=require"

# Supabase API (Standard Client & Edge Integration)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[supabase-anon-or-publishable-key]"

# Gnani Voice AI (Header: X-API-Key-ID for Vachana STT & TTS inference)
GNANI_API_KEY="your-gnani-api-key"

# Telegram Bot (grammY Webhook & Bot Integration)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_SECRET_TOKEN="your-telegram-webhook-secret"
TELEGRAM_BOT_USERNAME="VoterMitraBot"

# Security & App Configuration
DEV_ROUTES_SECRET="your-dev-routes-secret"
SESSION_SECRET="your-32-char-minimum-session-secret-here"
BENCHMARK_PLANTED_TOTAL=40
PUBLIC_BASE_URL="https://votermitra-hack.vercel.app"
