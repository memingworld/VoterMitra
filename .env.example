# VoterMitra Environment Variables
# Copy this file to .env.local for local development.
# Do NOT commit .env.local to version control.

# PostgreSQL connection string (Supabase Transaction Pooler, port 6543)
# e.g., postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# Gnani Vachana API credentials (Header: X-API-Key-ID)
GNANI_API_KEY="your-gnani-api-key"

# Secret required to access /api/dev routes in production (via 'x-dev-secret' header)
DEV_ROUTES_SECRET="your-dev-routes-secret"

# Dashboard sign-in
DASHBOARD_PASSCODE="your-dashboard-passcode"
# Generate with: openssl rand -hex 32
SESSION_SECRET="your-32-char-minimum-session-secret-here"
# Used for recall only if benchmark_scenarios is empty
BENCHMARK_PLANTED_TOTAL=40
# Optional: shows a "Use on Telegram" link on the home page (without the @)
TELEGRAM_BOT_USERNAME="VoterMitraBot"
# Public base URL
PUBLIC_BASE_URL="http://localhost:3000"
